if {![file exists "/home/charlie/Hardware/scope order 1/scope/lattice/scopesim/scopesim.mpf"]} { 
	project new "/home/charlie/Hardware/scope order 1/scope/lattice/scopesim" scopesim
	project addfile "/home/charlie/Hardware/scope order 1/scope/lattice/scopesim/fifo.v"
	project addfile "/home/charlie/Hardware/scope order 1/scope/lattice/scopesim/scope.v"
	vlib  work
	vdel -lib work -all 
	vlib work
	vlog  +incdir+/home/charlie/Hardware/scope order 1/scope/lattice/scopesim  -work work  "/home/charlie/Hardware/scope order 1/scope/lattice/scopesim/fifo.v"
	vlog  +incdir+/home/charlie/Hardware/scope order 1/scope/lattice/scopesim  -work work  "/home/charlie/Hardware/scope order 1/scope/lattice/scopesim/scope.v"
} else {
	project open "/home/charlie/Hardware/scope order 1/scope/lattice/scopesim/scopesim"
	project compileoutofdate
}
vsim -voptargs=+acc -L work -L pmi_work -L ovi_machxo2  adc_ft601 -t ns
view wave
add wave /*
run 1000ns
